{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ChameleonX",
  "version": "1.0.4",
  "identifier": "com.chameleonx.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev:vite",
    "beforeBuildCommand": "node scripts/build_sidecar.cjs && npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "變色龍指紋瀏覽器 (ChameleonX)",
        "width": 1440,
        "height": 880,
        "minWidth": 1080,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "windows": {
      "nsis": {
        "installerHooks": "hooks.nsh",
        "languages": ["TradChinese", "English"]
      }
    },
    "externalBin": [
      "binaries/chameleon-backend"
    ],
    "resources": [
      "resources/**/*"
    ],
    "icon": [
      "icons/icon.ico",
      "icons/icon.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/32x32.png"
    ]
  }
}
