{
  "name": "chameleonx",
  "version": "1.0.1",
  "description": "變色龍指紋瀏覽器 (ChameleonX) — 全繁體中文防關聯桌面系統 (支援無限制環境、批量操作、擴充功能自動掛載、Fingerprint-Chromium 核心)",
  "main": "electron/main.cjs",
  "scripts": {
    "dev:vite": "vite --port 5173",
    "dev:electron": "electron .",
    "dev": "node scripts/dev.cjs",
    "build": "vite build",
    "start": "electron .",
    "dist": "npm.cmd run build && electron-builder"
  },
  "build": {
    "appId": "com.chameleonx.app",
    "productName": "ChameleonX",
    "compression": "maximum",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "electron/backend/bringToTop.ps1"
    ],
    "extraResources": [
      {
        "from": "scripts/download_kernel_installer.ps1",
        "to": "scripts/download_kernel_installer.ps1"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "變色龍指紋瀏覽器 (ChameleonX)",
      "include": "build/installer.nsh"
    }
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "lucide-react": "^0.475.0",
    "proxy-chain": "^2.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.6",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^34.2.0",
    "electron-builder": "^26.15.3",
    "tailwindcss": "^4.0.6",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  }
}
